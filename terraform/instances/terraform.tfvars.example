# ==============================================================================
# Example Proxmox Instance Configuration Variables
# ==============================================================================
# Copy this file to terraform.tfvars and customize with your live cluster values:
#   cp terraform.tfvars.example terraform.tfvars
# Note: terraform.tfvars is ignored by Git to prevent credential leaks.
# ==============================================================================

# Proxmox VE API Connection
proxmox_endpoint  = "https://10.10.10.10:8006/"
proxmox_api_token = "terraform@pve!terraform-token=00000000-0000-0000-0000-000000000000"
proxmox_insecure  = true
proxmox_node      = "pve1"

# Proxmox Storage Pools
proxmox_storage_pool = "local-lvm"
proxmox_iso_pool     = "local-storage"
proxmox_bridge       = "vmbr0"

# Default Cloud-Init Administrator & SSH Key
ci_username    = "erenyx"
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@homelab"

# Private key counterpart to ssh_public_key above, used to SSH into the
# Proxmox node itself as root so the provider can upload cloud-init snippets
# (Proxmox has no API endpoint for snippet content, so this is mandatory).
ssh_private_key_path = "~/.ssh/id_ed25519"

# vmid of the golden template to clone from (default: 9000 / resolute)
clone_vm_id = 9000

# Override the `nodes` map in variables.tf here if you need different
# sizing, IPs, or vmids than the defaults baked in.
