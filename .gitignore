# ==============================================================================
# Homelab Automation Git Ignore Rules (Terraform & Infrastructure)
# ==============================================================================

# Local .terraform directories and plugin cache
**/.terraform/*
.terraform/
.cache/

# Terraform runtime state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash logs and runtime artifacts
crash.log
crash.*.log
*.log
scratch/
.system_generated/

# Sensitive variable files containing live credentials/tokens
*.tfvars
*.auto.tfvars
*.tfvars.json
*.auto.tfvars.json
secrets.*
*.key
*.pem

# Explicitly allow tracking sanitized example variable files
!*.example.tfvars
!*.example.pkrvars.hcl

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

